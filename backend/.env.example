# Copiar a .env y completar. .env está en .gitignore: nunca subir secretos.

# Servidor
PORT=8080

# Datos (desarrollo: docker compose up -d desde la raíz del repo).
# En Railway estas variables las inyectan los servicios de Postgres y Redis.
DATABASE_URL=postgres://owli:owli@localhost:5433/owli?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Créditos (modelo comercial)
CREDITS_FREE_DAILY_QUOTA=1
CREDITS_WELCOME=15
CREDITS_PRO_FAIR_USE_DAILY=25

# Gemini (usar SIEMPRE una key de un proyecto con facturación activa: tier de pago)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Anthropic (proveedor de respaldo; benchmark)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Groq (Whisper): respaldo de la voz cuando el dispositivo no puede transcribir. Vacío = sin respaldo.
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# Autenticación (JWT propio). En producción: variables de Railway.
# Generar con: openssl rand -base64 48   (mínimo 32 bytes; distinto en cada entorno)
JWT_SECRET=
# Solo durante una rotación: el secreto anterior, para no cortar sesiones.
JWT_SECRET_PREVIOUS=
# Client IDs separados por coma (bundle id de iOS / client id de Google). Vacío = proveedor deshabilitado.
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=
# Orígenes de la app (CORS). Por defecto: localhost:8100 y Capacitor.
CORS_ALLOWED_ORIGINS=

# Límites contra abuso (por defecto: 10 cuentas anónimas por IP y hora)
RATE_LIMIT_ANON_PER_IP_HOUR=
# Tope global de gasto diario en IA, en USD (red de seguridad contra bots)
AI_DAILY_BUDGET_USD=20

# Análisis con IA
APP_ENV=development
# Reconocedor simulado (pruebas, sin costo). Prohibido con APP_ENV=production.
AI_FAKE=
AI_PRIMARY_TIMEOUT_MS=15000
AI_FALLBACK_TIMEOUT_MS=20000
AI_FALLBACK_GRAMS_FACTOR=0.71
AI_COST_MICRO_USD=3000
RATE_LIMIT_AI_PER_USER_HOUR=30
AI_VOICE_COST_MICRO_USD=1000
AI_TRANSCRIBE_TIMEOUT_MS=15000
AI_TEXT_COST_MICRO_USD=500
